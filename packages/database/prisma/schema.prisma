datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String   @id @default(uuid())
  name        String
  category    String
  attributes  Json
  price       Float
  isCertified Boolean  @default(false)
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  issuedAt  DateTime @default(now())
}
